--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a31c78c26d62e95459b57867bec8c89e, type: 3}
  m_Name: TutorialConfig
  m_EditorClassIdentifier: Assembly-CSharp::TaskTown.Tutorial.TutorialConfigSO
  speakerName: "\uC2E0\uC0AC \uC624\uB9AC"
  speakerPortrait: {fileID: 21300000, guid: d9cd662a6558cc24d8b78070fcd8948c, type: 3}
  steps:
  - step: 0
    messages:
    - "\uC624! \uB2F9\uC2E0\uC774 \uC0C8\uB85C\uC6B4 \uCD0C\uC7A5\uB2D8\uC774\uC2DC\uAD70\uC694!"
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uC774\uB807\uAC8C
      \uC9C1\uC811 \uB9CC\uB098 \uBD59\uAC8C \uB418\uC5B4 \uBC18\uAC11\uAD70\uC694."
    - "\uBCF4\uC2DC\uB2E4\uC2DC\uD53C \uC774 \uB9C8\uC744\uC740 \uB2E4\uC2DC \uBB38\uC744
      \uC5F4\uC5C8\uC9C0\uB9CC, \uC544\uC9C1 \uC190\uBCFC \uACF3\uC774 \uC544\uC8FC
      \uB9CE\uC2B5\uB2C8\uB2E4."
    - "\uC608\uC804\uCC98\uB7FC \uB3D9\uBB3C\uB4E4\uC758 \uC6C3\uC74C\uC18C\uB9AC\uAC00
      \uAC00\uB4DD\uD55C \uB9C8\uC744\uB85C \uB418\uB3CC\uB9AC\uB824\uBA74 \uCD0C\uC7A5\uB2D8\uC758
      \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uC9C0\uC694."
    - "\uC800 \uB9D0\uC785\uB2C8\uAE4C? \uC800\uB294 \uADF8\uC800\u2026 \uC774 \uB9C8\uC744\uC758
      \uC0AC\uC815\uC744 \uC870\uAE08 \uC798 \uC544\uB294 \uC2E0\uC0AC \uC624\uB9AC\uB77C\uACE0
      \uD574\uB450\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uCD0C\uC7A5\uB2D8\uAED8\uC11C\uB294 \uC0C8\uB85C\uC6B4 \uC8FC\uBBFC\uC744
      \uB9DE\uC774\uD558\uACE0, \uADF8\uB4E4\uC774 \uC77C\uD560 \uC218 \uC788\uB294
      \uB3C4\uAD6C\uC640 \uC790\uB9AC\uB97C \uB9C8\uB828\uD574\uC8FC\uC2DC\uBA74
      \uB429\uB2C8\uB2E4."
    - "\uC8FC\uBBFC\uB4E4\uC774 \uD558\uB098\uB458 \uC790\uB9AC\uB97C \uC7A1\uC73C\uBA74,
      \uC870\uC6A9\uD588\uB358 \uB9C8\uC744\uB3C4 \uB2E4\uC2DC \uD65C\uAE30\uB97C
      \uB418\uCC3E\uAE30 \uC2DC\uC791\uD560 \uAC81\uB2C8\uB2E4."
    - "\uBB3C\uB860 \uCC98\uC74C\uBD80\uD130 \uBAA8\uB4E0 \uC77C\uC744 \uC54C\uACE0
      \uACC4\uC2E4 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uC81C\uAC00 \uD558\uB098\uC529
      \uC548\uB0B4\uD574\uB4DC\uB9AC\uC9C0\uC694."
    - "\uADF8\uB7FC \uCD0C\uC7A5\uB2D8, \uB9C8\uC744 \uC7AC\uAC74\uC744 \uC704\uD55C
      \uCCAB \uC5C5\uBB34\uB97C \uC2DC\uC791\uD574\uBCFC\uAE4C\uC694?"
    objectiveText: 
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 1
  - step: 1
    messages:
    - "\uD0C0\uC774\uD551\uACFC \uD074\uB9AD\uC73C\uB85C \uB9C8\uC744 \uC7AC\uAC74\uC5D0
      \uD544\uC694\uD55C \uCF54\uC778\uC744 \uBAA8\uC544\uBCF4\uC138\uC694!"
    objectiveText: "\uD0C0\uC774\uD551\uACFC \uD074\uB9AD\uC73C\uB85C Town Coin 100
      \uD68D\uB4DD"
    progressDisplayType: 1
    progressFormat: '{0} / {1} Town Coin'
    allowClickAdvance: 0
  - step: 2
    messages:
    - "\uBAA8\uC740 \uCF54\uC778\uC73C\uB85C \uB9C8\uC744\uC5D0 \uD568\uAED8\uD560
      \uB3D9\uBB3C\uC744 \uBD88\uB7EC\uBCFC\uAE4C\uC694?"
    objectiveText: "\uB3D9\uBB3C 1\uB9C8\uB9AC \uD68D\uB4DD"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 3
    messages:
    - "\uB3D9\uBB3C\uC774 \uC77C\uD558\uB824\uBA74 \uC0AC\uC6A9\uD560 \uB3C4\uAD6C\uAC00
      \uD544\uC694\uD574\uC694. \uB3C4\uAD6C\uB97C \uD558\uB098 \uBF51\uC544\uBCF4\uC138\uC694!"
    objectiveText: "\uB3C4\uAD6C 1\uAC1C \uD68D\uB4DD"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 4
    messages:
    - "\uC774\uC81C \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD560 \uB3D9\uBB3C\uC744 \uBC30\uCE58\uD574\uBCFC\uAE4C\uC694?"
    objectiveText: "\uB3C4\uAD6C\uC5D0 \uB3D9\uBB3C 1\uB9C8\uB9AC \uBC30\uCE58"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 5
    messages:
    - "\uB3D9\uBB3C\uC774 \uC77C\uC744 \uC2DC\uC791\uD588\uC5B4\uC694! \uC774\uC81C
      \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uCF54\uC778\uC774 \uC790\uB3D9\uC73C\uB85C
      \uC0DD\uC0B0\uB429\uB2C8\uB2E4."
    objectiveText: "\uC790\uB3D9 \uC0DD\uC0B0\uC73C\uB85C Town Coin \uD68D\uB4DD"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 6
    messages:
    - "\uB9C8\uC744 \uC815\uBCF4\uC5D0\uC11C\uB294 \uD604\uC7AC \uC131\uC7A5 \uC0C1\uD0DC\uC640
      \uB2E4\uC74C \uBAA9\uD45C\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    objectiveText: "\uC911\uC559 \uB9C8\uC744\uC744 \uD074\uB9AD\uD574 \uB9C8\uC744
      \uC815\uBCF4 \uD655\uC778"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 7
    messages:
    - "\uC900\uBE44\uAC00 \uB05D\uB0AC\uC5B4\uC694! \uB9C8\uC744\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uACE0
      \uB354 \uB9CE\uC740 \uB3D9\uBB3C\uACFC \uB3C4\uAD6C\uB97C \uBC30\uCE58\uD574\uBCF4\uC138\uC694."
    objectiveText: "\uD074\uB9AD\xB7\uD0C0\uC774\uD551\xB7\uB3C4\uAD6C \uD6A8\uC728
      \uC911 \uD558\uB098 \uC5C5\uADF8\uB808\uC774\uB4DC"
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 0
  - step: 8
    messages:
    - "\uC774\uC81C \uB9C8\uC744\uC744 \uC7AC\uAC74\uD560 \uC900\uBE44\uAC00 \uBAA8\uB450
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uCD0C\uC7A5\uB2D8\uC758 \uBC29\uC2DD\uC73C\uB85C
      \uB9C8\uC744\uC744 \uC131\uC7A5\uC2DC\uCF1C\uBCF4\uC138\uC694!"
    objectiveText: 
    progressDisplayType: 0
    progressFormat: '{0} / {1}'
    allowClickAdvance: 1
