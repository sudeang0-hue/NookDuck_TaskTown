  m_Script: {fileID: 11500000, guid: dea9101474b9f14478dcf257af843753, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIController_Difficultly
  difficultlyTitle:
  - {fileID: 0}
  - {fileID: 114273034312286410}
  - {fileID: 8921306526145559562}
  - {fileID: 2776736717254261594}
  difficultlyDescription:
  - {fileID: 0}
  - {fileID: 68543808386431388}
  - {fileID: 8838498469405279580}
  - {fileID: 2877393162287088140}
  difficultlyTitleText:
  - "\uC791\uC740 \uB9C8\uC744"
  - "\uD3C9\uBC94\uD55C \uB9C8\uC744"
  - "\uD2B9\uBCC4\uD55C \uB9C8\uC744"
  - "\uCD5C\uACE0\uC758 \uB9C8\uC744"
  difficultlyDescriptionText:
  - "\uBE60\uB974\uAC8C \uC131\uC7A5\uD560 \uC218 \uC788\uB294 \uC26C\uC6B4 \uB09C\uC774\uB3C4
    \uC785\uB2C8\uB2E4."
  - "\uD3B8\uC548\uD558\uAC8C \uB9C8\uC744\uC744 \uC131\uC7A5\uC2DC\uD0AC \uC218
    \uC788\uB294 \uAE30\uBCF8 \uB09C\uC774\uB3C4\uC785\uB2C8\uB2E4.\r\n\uC77C\uBC18\uC801\uC778
    \uC0DD\uC0B0 \uD6A8\uC728\uC774\uBA70 \uAE30\uBCF8 \uC8FC\uBBFC\uB4E4\uC744 \uB9CC\uB0A0
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB9C8\uC744 \uAD00\uB9AC\uAC00 \uC775\uC219\uD574\uC9C4 \uCD0C\uC7A5\uB2D8\uC744
    \uC704\uD55C \uC911\uAC04 \uB09C\uC774\uB3C4 \uC785\uB2C8\uB2E4.\r\n\uC0DD\uC0B0
    \uD6A8\uC728\uC774 \uAC10\uC18C\uD558\uC9C0\uB9CC \uB354 \uB2E4\uC591\uD55C \uB3D9\uBB3C
    \uC8FC\uBBFC\uC774 \uB9C8\uC744\uC5D0 \uCC3E\uC544\uC624\uAC8C \uB429\uB2C8\uB2E4."
  - "\uC219\uB828\uB41C \uCD0C\uC7A5\uB2D8\uC758 \uAD00\uB9AC\uAC00 \uD544\uC694\uD55C
    \uC5B4\uB824\uC6C0 \uB09C\uC774\uB3C4 \uC785\uB2C8\uB2E4.\r\n\uD6E8\uC52C \uB290\uB824\uC9C4
    \uC0DD\uC0B0 \uD658\uACBD\uC5D0\uC11C \uB9C8\uC744\uC744 \uC131\uC7A5\uC2DC\uCF1C\uC57C
    \uD558\uC9C0\uB9CC\r\n\uB354\uC6B1 \uD2B9\uBCC4\uD55C \uC8FC\uBBFC\uB4E4\uC774
    \uBC29\uBB38\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
