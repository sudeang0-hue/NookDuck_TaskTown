    - target: {fileID: 384469666721444625, guid: 58bf4b40a451a0a43b13e6182ed4a180, type: 3}
      propertyPath: m_text
      value: "<b>\uCD5C\uD76C\uC218 | \uD300\uC7A5 \xB7 \uB9AC\uB4DC \uAE30\uD68D
        \xB7 \uAC1C\uBC1C \uCD1D\uAD04</b>\n\uD504\uB85C\uC81D\uD2B8 \uAE30\uD68D,
        \uACF5\uD1B5 \uD504\uB808\uC784\uC6CC\uD06C, \uC0AC\uC6B4\uB4DC \uC2DC\uC2A4\uD15C,
        \uAE30\uB2A5 \uD1B5\uD569, Git\xB7QA\xB7\uBE4C\uB4DC \uAD00\uB9AC\n\n<b>\uAE40\uB3C4\uD604
        | \uCF54\uC5B4 \uAC8C\uC784\uD50C\uB808\uC774 \uAC1C\uBC1C</b>\n\uC804\uC5ED
        \uC785\uB825, \uD575\uC2EC \uD50C\uB808\uC774 \uB8E8\uD504, \uAC8C\uC784
        \uC9C4\uD589, \uC5D4\uB529\xB7\uB9AC\uC14B\xB7\uB09C\uC774\uB3C4 \uC804\uD658
        \uC2DC\uC2A4\uD15C\n\n<b>\uC815\uB098\uBC94 | UX\xB7\uBE44\uC8FC\uC5BC \uBC0F
        \uCF58\uD150\uCE20 \uAC1C\uBC1C</b>\n\uBA54\uC778 UI \uB514\uC790\uC778,
        \uB9C8\uC744/\uB3D9\uBB3C \uBAA8\uB378\uB9C1,  \uAE30\uB2A5 \uC5F0\uCD9C,
        \uC624\uBE0C\uC81D\uD2B8 \uBC30\uCE58 \uCF58\uD150\uCE20\n\n<b>\uAE40\uB0A8\uC6B0
        | \uC131\uC7A5\xB7\uACBD\uC81C \uC2DC\uC2A4\uD15C \uAC1C\uBC1C</b>\n\uB3D9\uBB3C\xB7\uB3C4\uAD6C
