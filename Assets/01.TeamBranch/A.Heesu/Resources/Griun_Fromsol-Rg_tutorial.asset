  m_Material: {fileID: -3334129492857309275}
  m_SourceFontFileGUID: 06be40fb72768bf4e8dfa9e695ebe86d
  m_CreationSettings:
    sourceFontFileName: 
    sourceFontFileGUID: 06be40fb72768bf4e8dfa9e695ebe86d
    faceIndex: 0
    pointSizeSamplingMode: 0
    pointSize: 158
    padding: 14
    paddingMode: 1
    packingMode: 4
    atlasWidth: 2048
    atlasHeight: 2048
    characterSetSelectionMode: 8
    characterSequence: "\uC2E0\uC0AC \uC624\uB9AC\n\n\uC624! \uB2F9\uC2E0\uC774 \uC0C8\uB85C\uC6B4
      \uCD0C\uC7A5\uB2D8\uC774\uC2DC\uAD70\uC694!\n\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uB807\uAC8C \uC9C1\uC811 \uB9CC\uB098 \uBD59\uAC8C \uB418\uC5B4 \uBC18\uAC11\uAD70\uC694.\n\uBCF4\uC2DC\uB2E4\uC2DC\uD53C
      \uC774 \uB9C8\uC744\uC740 \uB2E4\uC2DC \uBB38\uC744 \uC5F4\uC5C8\uC9C0\uB9CC,
      \uC544\uC9C1 \uC190\uBCFC \uACF3\uC774 \uC544\uC8FC \uB9CE\uC2B5\uB2C8\uB2E4.\n\uC608\uC804\uCC98\uB7FC
      \uB3D9\uBB3C\uB4E4\uC758 \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uAC00\uB4DD\uD55C
      \uB9C8\uC744\uB85C \uB418\uB3CC\uB9AC\uB824\uBA74 \uCD0C\uC7A5\uB2D8\uC758
      \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uC9C0\uC694.\n\uC800 \uB9D0\uC785\uB2C8\uAE4C?
      \uC800\uB294 \uADF8\uC800\u2026 \uC774 \uB9C8\uC744\uC758 \uC0AC\uC815\uC744
      \uC870\uAE08 \uC798 \uC544\uB294 \uC2E0\uC0AC \uC624\uB9AC\uB77C\uACE0 \uD574\uB450\uACA0\uC2B5\uB2C8\uB2E4.\n\uCD0C\uC7A5\uB2D8\uAED8\uC11C\uB294
      \uC0C8\uB85C\uC6B4 \uC8FC\uBBFC\uC744 \uB9DE\uC774\uD558\uACE0, \uADF8\uB4E4\uC774
      \uC77C\uD560 \uC218 \uC788\uB294 \uB3C4\uAD6C\uC640 \uC790\uB9AC\uB97C \uB9C8\uB828\uD574\uC8FC\uC2DC\uBA74
      \uB429\uB2C8\uB2E4.\n\uC8FC\uBBFC\uB4E4\uC774 \uD558\uB098\uB458 \uC790\uB9AC\uB97C
      \uC7A1\uC73C\uBA74, \uC870\uC6A9\uD588\uB358 \uB9C8\uC744\uB3C4 \uB2E4\uC2DC
      \uD65C\uAE30\uB97C \uB418\uCC3E\uAE30 \uC2DC\uC791\uD560 \uAC81\uB2C8\uB2E4.\n\uBB3C\uB860
      \uCC98\uC74C\uBD80\uD130 \uBAA8\uB4E0 \uC77C\uC744 \uC54C\uACE0 \uACC4\uC2E4
      \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uC81C\uAC00 \uD558\uB098\uC529
      \uC548\uB0B4\uD574\uB4DC\uB9AC\uC9C0\uC694.\n\uADF8\uB7FC \uCD0C\uC7A5\uB2D8,
      \uB9C8\uC744 \uC7AC\uAC74\uC744 \uC704\uD55C \uCCAB \uC5C5\uBB34\uB97C \uC2DC\uC791\uD574\uBCFC\uAE4C\uC694?\n\uCC29\n\uD0C0\uC774\uD551\uACFC
      \uD074\uB9AD\uC73C\uB85C \uB9C8\uC744 \uC7AC\uAC74\uC5D0 \uD544\uC694\uD55C
      \uCF54\uC778\uC744 \uBAA8\uC544\uBCF4\uC138\uC694!\n\uD0C0\uC774\uD551\uACFC
      \uD074\uB9AD\uC73C\uB85C Town Coin 100 \uD68D\uB4DD\n\n\uD6CC\uB96D\uD569\uB2C8\uB2E4,
      \uCD0C\uC7A5\uB2D8! \uB9C8\uC744 \uC7AC\uAC74\uC5D0 \uD544\uC694\uD55C \uCF54\uC778\uC774
      \uBAA8\uC774\uAE30 \uC2DC\uC791\uD588\uAD70\uC694.\n\uCD0C\uC7A5\uB2D8\uAED8\uC11C
      \uB2E4\uB978 \uC77C\uC744 \uD558\uC2E4 \uB54C\uB294, \uD0C0\uC6B4\uC744 \uC791\uAC8C
      \uC811\uC5B4\uB458 \uC218\uB3C4 \uC788\uB2F5\uB2C8\uB2E4.\n\uD654\uBA74\uC758
      \uCD95\uC18C \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD0C0\uC6B4\uC744 \uC791\uAC8C
      \uB9CC\uB4E4\uC5B4\uBCF4\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uD0C0\uC6B4\uC744
      \uCD95\uC18C\uD55C \uB4A4, \uB2E4\uC2DC \uD655\uC7A5 \uD654\uBA74\uC73C\uB85C
      \uB3CC\uC544\uC640\uBCF4\uC138\uC694!\n\uC798\uD558\uC168\uC5B4\uC694!\n\uC774\uB807\uAC8C
      \uD0C0\uC6B4\uC744 \uC791\uAC8C \uC811\uC5B4\uB450\uC5C8\uB2E4\uAC00, \uC5B8\uC81C\uB4E0
      \uB2E4\uC2DC \uB3CC\uC544\uC640 \uB0A8\uC740 \uC77C\uB4E4\uC744 \uC774\uC5B4\uAC08
      \uC218 \uC788\uB2F5\uB2C8\uB2E4.\n\uCD0C\uC7A5\uB2D8\uAED8\uC11C \uB2E4\uB978
      \uC77C\uC744 \uD558\uB294 \uB3D9\uC548\uC5D0\uB3C4, \uB9C8\uC744\uC758 \uC8FC\uBBFC\uB4E4\uC740
      \uAC01\uC790\uC758 \uC790\uB9AC\uC5D0\uC11C \uC5F4\uC2EC\uD788 \uC77C\uD558\uAC8C
      \uB420 \uAC81\uB2C8\uB2E4.\n\uD0C0\uC6B4\uC73C\uB85C \uB3CC\uC544\uC624\uC168\uC73C\uB2C8,
      \uC774\uC81C \uB9C8\uC744\uC5D0 \uD568\uAED8\uD560 \uCCAB \uBC88\uC9F8 \uC8FC\uBBFC\uC744
      \uB9DE\uC774\uD574\uBCFC\uAE4C\uC694?\n\n\uBAA8\uC740 \uCF54\uC778\uC73C\uB85C
      \uB9C8\uC744\uC5D0 \uD568\uAED8\uD560 \uB3D9\uBB3C\uC744 \uBD88\uB7EC\uBCFC\uAE4C\uC694?\n\uC9C0\uAE09\uBC1B\uC740
      \uCF54\uC778\uC73C\uB85C \uB9C8\uC744\uC5D0 \uD568\uAED8\uD560 \uB3D9\uBB3C\uC744
      \uBD88\uB7EC\uBCF4\uC138\uC694!\n\n\uB3D9\uBB3C\uC774 \uC77C\uD558\uB824\uBA74
      \uC0AC\uC6A9\uD560 \uB3C4\uAD6C\uAC00 \uD544\uC694\uD574\uC694. \uB3C4\uAD6C\uB97C
      \uD558\uB098 \uBF51\uC544\uBCF4\uC138\uC694!\n\uB3C4\uAD6C 1\uAC1C \uD68D\uB4DD\n\n\uC774\uC81C
      \uB3D9\uBB3C\uC5D0\uAC8C \uB3C4\uAD6C\uB97C \uC7A5\uCC29\uC2DC\uCF1C\uBCFC\uAE4C\uC694?\n\uC5BB\uC740
      \uB3D9\uBB3C\uC5D0 \uB3C4\uAD6C\uB97C \uC7A5\uCC29(\uBC30\uCE58)\uD574\uBCF4\uC138\uC694!\n\n\uB3D9\uBB3C\uC774
      \uC77C\uC744 \uC2DC\uC791\uD588\uC5B4\uC694! \uC774\uC81C \uC2DC\uAC04\uC774
      \uC9C0\uB098\uBA74 \uCF54\uC778\uC774 \uC790\uB3D9\uC73C\uB85C \uC0DD\uC0B0\uB429\uB2C8\uB2E4.\n\uC790\uB3D9
      \uC0DD\uC0B0\uC73C\uB85C Town Coin 50 \uD68D\uB4DD\n\n\uB9C8\uC744 \uC815\uBCF4\uC5D0\uC11C\uB294
      \uD604\uC7AC \uC131\uC7A5 \uC0C1\uD0DC\uC640 \uB2E4\uC74C \uBAA9\uD45C\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694.\n\uC911\uC559 \uB9C8\uC744\uC744
      \uD074\uB9AD\uD574 \uB9C8\uC744 \uC815\uBCF4 \uD655\uC778\n\n\uC900\uBE44\uAC00
      \uB05D\uB0AC\uC5B4\uC694! \uB9C8\uC744\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uACE0
      \uB354 \uB9CE\uC740 \uB3D9\uBB3C\uACFC \uB3C4\uAD6C\uB97C \uBC30\uCE58\uD574\uBCF4\uC138\uC694.\n\uD074\uB9AD\xB7\uD0C0\uC774\uD551\xB7\uB3C4\uAD6C
      \uD6A8\uC728 \uC911 \uD558\uB098 \uC5C5\uADF8\uB808\uC774\uB4DC\n\n\uC774\uC81C
      \uB9C8\uC744\uC744 \uC7AC\uAC74\uD560 \uC900\uBE44\uAC00 \uBAA8\uB450 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.
      \uCD0C\uC7A5\uB2D8\uC758 \uBC29\uC2DD\uC73C\uB85C \uB9C8\uC744\uC744 \uC131\uC7A5\uC2DC\uCF1C\uBCF4\uC138\uC694!\n\n0123456789
      / {0} {1}\nPORTRAIT\nQUEST\nDUCK GUIDE\n0 / 100 Town Coin\nCurrent tutorial
      objective\nTutorial dialogue appears in this speech bubble.\n"
